	partition Items = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(#"Exports folder" & "Items.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"Item ID", type text}, {"Item", type text}, {"Category", type text}, {"Shop", type text}, {"Paid with", type text}, {"State", type text}, {"Bought", type date}, {"Cost", Currency.Type}, {"Sold", type date}, {"Price", Currency.Type}, {"Fees", Currency.Type}, {"Postage", Currency.Type}, {"Platform", type text}, {"Refunded", type date}, {"Profit", Currency.Type}, {"Margin", type number}, {"Days held", Int64.Type}}, "en-GB")
				in
				    Typed

	annotation PBI_ResultType = Table

