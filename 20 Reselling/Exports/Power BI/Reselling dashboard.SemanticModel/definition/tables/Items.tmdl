table Items
	lineageTag: d5b81a24-41c0-417b-bac9-452b4688de26

	measure Spent = SUM ( Items[Cost] )
		formatString: \£#,0.00;-\£#,0.00;\£#,0.00
		lineageTag: 26ea839e-3d02-46bc-97f4-38d88dd895c4

	measure 'Items bought' = COUNTROWS ( Items )
		formatString: 0
		lineageTag: 8ddac177-23cb-4472-870f-3decfa5c3d3e

	measure 'Items held' = CALCULATE ( COUNTROWS ( Items ), Items[State] IN { "in stock", "listed" } )
		formatString: 0
		lineageTag: d0b6f58e-21f3-48be-9c19-4044ef59d089

	measure 'Capital tied up' = CALCULATE ( SUM ( Items[Cost] ), Items[State] IN { "in stock", "listed" } )
		formatString: \£#,0.00;-\£#,0.00;\£#,0.00
		lineageTag: c9f36a80-466a-46e0-acfb-7f67be060919

	measure 'Refunds due' = CALCULATE ( SUM ( Items[Cost] ), Items[State] = "returning" )
		formatString: \£#,0.00;-\£#,0.00;\£#,0.00
		lineageTag: d55cf22b-b42b-486a-877e-35f4c7b5b4ba

	measure 'Held over 30 days' = CALCULATE ( [Items held], Items[Days held] > 30 )
		formatString: 0
		lineageTag: 215ddaee-31a5-4958-a850-563ef1d3989b

	measure 'Items sold' = CALCULATE ( COUNTROWS ( Items ), Items[State] = "sold", USERELATIONSHIP ( Calendar[Date], Items[Sold] ) )
		formatString: 0
		lineageTag: 17db994c-f9cc-4033-bca6-ff4ee9ca371d

	measure Revenue = CALCULATE ( SUM ( Items[Price] ), USERELATIONSHIP ( Calendar[Date], Items[Sold] ) )
		formatString: \£#,0.00;-\£#,0.00;\£#,0.00
		lineageTag: 0e6c7abc-205d-4c5f-863a-bb415e49b6a0

	measure 'Gross profit' = CALCULATE ( SUM ( Items[Profit] ), USERELATIONSHIP ( Calendar[Date], Items[Sold] ) )
		formatString: \£#,0.00;-\£#,0.00;\£#,0.00
		lineageTag: 2e7b0a63-7950-4f6a-aa93-0db5efbdb676

	measure 'Cost of sold' = CALCULATE ( SUM ( Items[Cost] ), Items[State] = "sold", USERELATIONSHIP ( Calendar[Date], Items[Sold] ) )
		formatString: \£#,0.00;-\£#,0.00;\£#,0.00
		lineageTag: a9ae9fcf-e2e0-4d96-8138-a73765179afb

	measure 'Margin %' = DIVIDE ( [Gross profit], [Cost of sold] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: c22a722d-18ab-45c0-ab92-060d95f06c70

	measure 'Avg days to sell' = CALCULATE ( AVERAGE ( Items[Days held] ), Items[State] = "sold" )
		formatString: 0.0
		lineageTag: 0d47e742-af19-4d72-9aee-2224b517f99c

	measure 'Other costs' = SUM ( Expenses[Amount] )
		formatString: \£#,0.00;-\£#,0.00;\£#,0.00
		lineageTag: 4e7cbbb4-c70f-40a2-84c9-f59aa91d7440

	measure 'Net profit' = [Gross profit] - [Other costs]
		formatString: \£#,0.00;-\£#,0.00;\£#,0.00
		lineageTag: c630702c-48c1-44b2-b1e6-20c3a6585a15

	measure 'Sell-through %' = DIVIDE ( CALCULATE ( COUNTROWS ( Items ), Items[State] = "sold" ), CALCULATE ( COUNTROWS ( Items ), Items[State] IN { "in stock", "listed", "sold" } ) )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: b3318330-7401-4704-b68d-e174f0a71cd2

