table Calendar
	lineageTag: 3e31ecf0-a879-40d1-a935-43dc4d554375
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: dd-mm-yyyy
		lineageTag: 399d597d-875f-4f98-ab7a-e8852d7452af
		summarizeBy: none
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

	column Month
		dataType: string
		lineageTag: 51d35465-8caf-4fd0-928f-8cac1269cf30
		summarizeBy: none
		sourceColumn: [Month]
		sortByColumn: 'Month number'

		annotation SummarizationSetBy = Automatic

	column 'Month number'
		dataType: int64
		formatString: 0
		lineageTag: 4ff9e208-c719-4ad2-8ed8-862674ee0f60
		summarizeBy: none
		sourceColumn: [Month number]

		annotation SummarizationSetBy = Automatic

	partition Calendar = calculated
		mode: import
		source = ```
				ADDCOLUMNS (
				    CALENDAR ( DATE ( 2026, 8, 1 ), DATE ( 2027, 12, 31 ) ),
				    "Month", FORMAT ( [Date], "mmm yyyy" ),
				    "Month number", YEAR ( [Date] ) * 100 + MONTH ( [Date] )
				)
				```
