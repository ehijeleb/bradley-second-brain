table Savings
	lineageTag: 35a1b343-de4f-40ef-8887-d39c3534db12

	column Date
		dataType: dateTime
		formatString: dd-mm-yyyy
		lineageTag: e8c94ddc-69d7-4d18-ac65-60a32ccba523
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

	column Account
		dataType: string
		lineageTag: b8a87d19-eee4-4675-8ab6-4be9057317ed
		summarizeBy: none
		sourceColumn: Account

		annotation SummarizationSetBy = Automatic

	column Balance
		dataType: decimal
		formatString: \£#,0.00;-\£#,0.00;\£#,0.00
		lineageTag: d774694e-1115-4403-b9fc-b79f82a3907f
		summarizeBy: sum
		sourceColumn: Balance

		annotation SummarizationSetBy = Automatic

	partition Savings = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(#"Exports folder" & "Savings.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"Date", type date}, {"Account", type text}, {"Balance", Currency.Type}}, "en-GB")
				in
				    Typed

	annotation PBI_ResultType = Table
