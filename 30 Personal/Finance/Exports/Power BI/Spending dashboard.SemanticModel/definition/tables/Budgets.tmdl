table Budgets
	lineageTag: 5787f341-0f5c-4a7d-98d6-eb70969de376

	column Category
		dataType: string
		lineageTag: f62e16a3-6532-4df0-9082-6b71cc22e35d
		summarizeBy: none
		sourceColumn: Category

		annotation SummarizationSetBy = Automatic

	column Group
		dataType: string
		lineageTag: f62cc364-a1df-4837-864d-2dfc7259aab5
		summarizeBy: none
		sourceColumn: Group

		annotation SummarizationSetBy = Automatic

	column 'Monthly budget'
		dataType: decimal
		formatString: \£#,0.00;-\£#,0.00;\£#,0.00
		lineageTag: 369be147-b416-400e-a381-f4866dbfc8ad
		summarizeBy: sum
		sourceColumn: Monthly budget

		annotation SummarizationSetBy = Automatic

	partition Budgets = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(#"Exports folder" & "Budgets.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"Category", type text}, {"Group", type text}, {"Monthly budget", Currency.Type}}, "en-GB")
				in
				    Typed

	annotation PBI_ResultType = Table
